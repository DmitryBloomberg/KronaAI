# Required: create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# The default lightweight local chat model is downloaded on the first /start.
OLLAMA_MODEL=qwen2.5:3b

# Optional: enable image generation. The key is read only from this local .env.
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-1

# Optional: enable photo understanding. Vision models are larger than the chat model.
# Example: OLLAMA_VISION_MODEL=llava:7b
OLLAMA_VISION_MODEL=

# Optional tuning
HISTORY_LIMIT=12
LOG_LEVEL=INFO
